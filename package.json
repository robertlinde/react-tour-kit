{
  "name": "@robertlinde/react-tour-kit",
  "version": "0.4.0",
  "type": "module",
  "description": "Guided product tours for React and React Native. Smooth, accessible, and guaranteed to stay on screen: the target is scrolled into view and the tooltip never renders out of sight.",
  "author": "Robert Linde",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/robertlinde/react-tour-kit.git"
  },
  "homepage": "https://github.com/robertlinde/react-tour-kit#readme",
  "bugs": {
    "url": "https://github.com/robertlinde/react-tour-kit/issues"
  },
  "keywords": [
    "react",
    "react-native",
    "expo",
    "tour",
    "product-tour",
    "guided-tour",
    "walkthrough",
    "onboarding",
    "spotlight",
    "tooltip",
    "accessibility"
  ],
  "sideEffects": false,
  "exports": {
    "./react": {
      "types": "./dist/react.d.ts",
      "default": "./dist/react.js"
    },
    "./react-native": {
      "types": "./dist/react-native.d.ts",
      "default": "./dist/react-native.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "MIGRATION.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.tooling.json",
    "lint": "xo",
    "lint:fix": "xo --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:component": "vitest run --project web --project native --project jsdom",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "check:package": "publint --strict && attw --pack . --profile esm-only",
    "smoke:node": "node test/smoke-node.mjs",
    "demo:web": "npm run dev --prefix demos/react",
    "demo:ios": "npm run ios --prefix demos/react-native",
    "demo:android": "npm run android --prefix demos/react-native",
    "prepare": "husky || true"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "react-native": ">=0.79.0"
  },
  "peerDependenciesMeta": {
    "react-dom": {
      "optional": true
    },
    "react-native": {
      "optional": true
    }
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@axe-core/playwright": "4.13.0",
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@estruyf/github-actions-reporter": "1.13.0",
    "@playwright/test": "1.64.0",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/browser": "5.0.3",
    "@vitest/browser-playwright": "5.0.3",
    "fast-check": "4.10.2",
    "husky": "9.1.7",
    "jsdom": "30.1.2",
    "lint-staged": "17.6.0",
    "prettier": "3.9.10",
    "publint": "0.3.25",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.87.1",
    "react-native-web": "0.21.4",
    "typescript": "6.0.3",
    "vitest": "5.0.3",
    "vitest-browser-react": "2.3.0",
    "xo": "2.0.2"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
